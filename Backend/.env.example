# Server
PORT=5000
NODE_ENV=development

# MySQL (XAMPP defaults work without changes)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=amora_ai
DB_USER=root
DB_PASS=

# These are automatically replaced with secure secrets in development on first start.
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# Optional SMTP. Leave all three blank in development to use the OTP console/API fallback.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Comma-separated Android/iOS OAuth client IDs. Leave as skip-for-now to disable Google login.
GOOGLE_CLIENT_IDS=skip-for-now

# Use * during development; set a specific client origin before production.
CORS_ORIGIN=*
