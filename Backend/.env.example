# Server
PORT=5000
NODE_ENV=development

# Development/testing only. Never enable or configure these in production.
TEST_FIXED_OTP_ENABLED=false
TEST_FIXED_OTP=
TEST_OTP_SKIP_DELIVERY=false

# Exceptional production-only controlled testing. Leave disabled unless an
# approved, temporary allowlisted live test is actively in progress. Invalid,
# missing, or expired configuration automatically disables this mechanism.
LIVE_TEST_OTP_ENABLED=false
LIVE_TEST_OTP_VALUE=
LIVE_TEST_OTP_PHONE_ALLOWLIST=
LIVE_TEST_OTP_EXPIRES_AT=

# Deterministic development/demo data. The seed command also requires a non-production
# NODE_ENV, an explicit database allowlist, and --confirm-development-db.
ALLOW_DUMMY_SEED=false
DUMMY_SEED_DATABASES=
SEED_USER_COUNT=150
SEED_RANDOM_SEED=12345
SEED_REFERENCE_DATE=2026-08-29
SEED_TEST_PASSWORD=Amoraa-Dev-Only-2026!
# Run `npm run setup:demo-portrait-assets` once to cache the CC0 AI-generated
# source portraits locally, then run `npm run db:seed:dummy`.

# MySQL (XAMPP defaults work without changes)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=amora_ai
# Integration tests refuse to use DB_NAME and use this separate schema.
TEST_DB_NAME=amora_ai_test
DB_USER=root
DB_PASS=

# These are automatically replaced with secure secrets in development on first start.
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
ADMIN_JWT_SECRET=changeme

# Dedicated administrator session lifetimes.
ADMIN_ACCESS_TOKEN_TTL_MINUTES=15
ADMIN_REFRESH_TOKEN_TTL_DAYS=30
ADMIN_PASSWORD_RESET_TTL_MINUTES=30
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_MFA_CHALLENGE_TTL_MINUTES=5
ADMIN_MFA_STEP_UP_TTL_MINUTES=10
ADMIN_WEB_RESET_URL=http://localhost:3000/reset-password
ADMIN_WEB_INVITATION_URL=http://localhost:3000/accept-invitation

# Optional SMTP. Leave all three blank in development to use the OTP console/API fallback.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Optional SMS delivery. Leave blank in development to use the OTP console/API fallback.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated Android/iOS OAuth client IDs. Leave as skip-for-now to disable Google login.
GOOGLE_CLIENT_IDS=skip-for-now

# Firebase Cloud Messaging HTTP v1. Server-side only. Use the service account
# for the same Firebase project as the Android/iOS apps. Keep the private key
# out of source control and preserve escaped newlines when stored in .env.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Credentialed Admin Web requests require its explicit origin. Production values
# must use HTTPS; browser Admin mutations use this Origin check as CSRF defense.
CORS_ORIGIN=http://localhost:3000

# Razorpay payment gateway. Use Test Mode keys for development and CI sandbox
# validation. Secrets must never be added to Flutter or committed here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional override for a provider-compatible sandbox/test server.
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
