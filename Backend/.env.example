# Server
PORT=5000
NODE_ENV=development

# MySQL (XAMPP defaults work without changes)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=amora_ai
# Integration tests refuse to use DB_NAME and use this separate schema.
TEST_DB_NAME=amora_ai_test
DB_USER=root
DB_PASS=

# These are automatically replaced with secure secrets in development on first start.
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# Optional SMTP. Leave all three blank in development to use the OTP console/API fallback.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Optional SMS delivery. Leave blank in development to use the OTP console/API fallback.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated Android/iOS OAuth client IDs. Leave as skip-for-now to disable Google login.
GOOGLE_CLIENT_IDS=skip-for-now

# Use * during development; set a specific client origin before production.
CORS_ORIGIN=*

# Razorpay payment gateway. Use Test Mode keys for development and CI sandbox
# validation. Secrets must never be added to Flutter or committed here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional override for a provider-compatible sandbox/test server.
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
