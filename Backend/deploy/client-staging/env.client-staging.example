# AMORAA client-QA staging environment template.
# Copy to /root/AMORA-AI-CLIENT-STAGING/Backend/.env on the server, fill every
# <...> value there, and chmod 600. Never commit the filled file.

NODE_ENV=staging
PORT=5002
TRUST_PROXY_HOPS=1

# Isolated staging schema and user. Must NOT be the production schema.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amora_ai_client_staging
DB_USER=amora_client_staging
# The backend reads DB_PASS (not DB_PASSWORD).
DB_PASS=<STAGING_ONLY_DB_PASSWORD>
DB_MIGRATION_STARTUP_MODE=verify
TEST_DB_NAME=amora_ai_client_staging_test

# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# All three must differ from each other and from production.
JWT_SECRET=<STAGING_ONLY_64_BYTE_HEX>
JWT_REFRESH_SECRET=<STAGING_ONLY_64_BYTE_HEX>
ADMIN_JWT_SECRET=<STAGING_ONLY_64_BYTE_HEX>
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_MFA_ENCRYPTION_KEY=<STAGING_ONLY_32_BYTE_HEX>

# Native app requests carry no Origin; list only staging browser origins here.
CORS_ORIGIN=https://client-api.searchenginemonks.com

# Generic fixed-OTP controls stay OFF for client staging.
TEST_FIXED_OTP_ENABLED=false
TEST_FIXED_OTP=
TEST_OTP_SKIP_DELIVERY=false

# Restricted client-QA OTP: only these numbers, only until the expiry.
LIVE_TEST_OTP_ENABLED=true
LIVE_TEST_OTP_VALUE=111111
LIVE_TEST_OTP_PHONE_ALLOWLIST=<+91XXXXXXXXXX approved client QA number(s), comma-separated>
LIVE_TEST_OTP_EXPIRES_AT=<UTC ISO timestamp, e.g. 2026-11-07T18:30:00Z>

# Optional providers. Leave blank unless sandbox credentials are approved.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Razorpay TEST-mode keys only (rzp_test_...). Never live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Isolated storage under the staging tree.
AMORA_PRIVATE_UPLOAD_ROOT=/root/AMORA-AI-CLIENT-STAGING/Backend/private-uploads
AMORA_PRIVATE_EXPORT_ROOT=/root/AMORA-AI-CLIENT-STAGING/Backend/private-exports

REQUIRE_DISTRIBUTED_RATE_LIMIT=false
ENABLE_PERFORMANCE_METRICS=false
